# Copy to .env and fill in.
PORT=4000
NODE_ENV=development

# SQLite protection. Production Docker images require the live database to be
# beneath /app/data, which must be a Coolify persistent-storage mount.
DB_PERSISTENT_ROOT=/app/data
DB_REQUIRE_PERSISTENT_STORAGE=0
DB_BACKUP_DIR=./data/backups
DB_BACKUP_INTERVAL_MINUTES=60
DB_BACKUP_KEEP_HOURLY=48
DB_BACKUP_KEEP_DAILY=30
DB_BACKUP_KEEP_WEEKLY=12
# Optional second mounted disk or remote-filesystem path. A verified copy of
# every backup is written here in addition to the main persistent volume.
DB_BACKUP_MIRROR_DIR=

# Translations are fully local — 53 languages pre-translated and shipped as
# JSON files in server/data/translations/. No external API key needed.

# Upstream zones/groups source.
# The Churches directory uses its canonical HTTPS endpoint in server/routes/zones.js.

# Main-dashboard authentication through KingsChat. The client ID is public;
# access tokens are received at runtime and must never be added here or committed.
KINGSCHAT_CLIENT_ID=com.kingschat
# Set this explicitly behind a reverse proxy, e.g. https://reports.example.org/api/auth/kingschat/callback
KINGSCHAT_REDIRECT_URI=
